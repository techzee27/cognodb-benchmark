# Copy to .env and fill in. Never commit the real .env file.
# Load with: export $(cat .env | xargs)  -- or use python-dotenv in scripts.

# CognoDB Cloud
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_PASSWORD=

# Neo4j AuraDB Free
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ArangoDB Oasis
ARANGO_URL=https://<deployment>.arangodb.cloud:8529
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DB=benchmark

# Memgraph Cloud
MEMGRAPH_URI=bolt://<instance>.memgraph.cloud:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# FalkorDB Cloud
FALKORDB_HOST=<instance-host>.falkordb.cloud
FALKORDB_PORT=6379
FALKORDB_USER=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=benchmark
# FALKORDB_URL=redis://<user>:<password>@<host>:<port>

